# Dependencies
node_modules/

# Secrets — never commit these. .env holds the JWT signing key and database
# credentials; .env.example is the committed template.
.env
.env.local
.env.*.local
!.env.example

# Build output
dist/
build/
*.tsbuildinfo

# Prisma generates its client from schema.prisma, so it is derived, not source.
backend/generated/

# Expo / React Native
.expo/
web-build/
expo-env.d.ts

# Native projects are regenerated by `expo prebuild`
mobile/android/
mobile/ios/

# Signing material — losing these is bad, committing them is worse
*.jks
*.keystore
*.p8
*.p12
*.key
*.mobileprovision

# Editors and OS
.DS_Store
*.log
.idea/
.vscode/

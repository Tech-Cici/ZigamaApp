# Used by the Prisma CLI for migrations (`npx prisma migrate dev`).
# With a local `npx prisma dev` server this is the prisma+postgres:// URL it prints.
DATABASE_URL="prisma+postgres://localhost:51213/?api_key=REPLACE_ME"

# Used by the application at runtime. Prisma 7's driver adapter speaks plain
# Postgres over TCP and cannot open a prisma+postgres:// URL, so point this at
# the direct connection string `npx prisma dev` prints as DATABASE_URL.
# Against a hosted Postgres (Supabase, Neon, RDS, docker) set this to the same
# value as DATABASE_URL above, or delete it entirely.
DIRECT_DATABASE_URL="postgres://postgres:postgres@localhost:51214/template1?sslmode=disable"

# Secret used to sign JWTs. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="replace-with-a-long-random-string"
JWT_EXPIRES_IN="12h"

PORT=3000

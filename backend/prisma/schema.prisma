// Zigama banking platform — data model
//
// Money is stored as BigInt in *minor units* (1 RWF = 100 minor units).
// Never use Float/Double for money: binary floating point cannot represent
// values like 0.10 exactly, and the error compounds across transactions.

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  runtime      = "nodejs"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CUSTOMER
  MANAGER
  ADMIN
}

enum AccountType {
  CHECKING
  SAVINGS
}

enum AccountStatus {
  /// Created but not yet approved. Deliberately the default: the existing
  /// `assertOperable` check in the ledger already rejects anything that is not
  /// ACTIVE, so an unapproved account cannot transact without a single new
  /// check anywhere in the money-movement code.
  PENDING
  ACTIVE
  FROZEN
  CLOSED
}

/// Maker-checker state for a customer record. The staff member who creates an
/// account may never be the one who approves it.
enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum TransactionType {
  DEPOSIT
  WITHDRAWAL
  TRANSFER_IN
  TRANSFER_OUT

  /// Compensating entries. The ledger is append-only, so undoing a movement
  /// writes an opposing row rather than editing or deleting the original.
  ///
  /// Two of them, rather than one `REVERSAL`, so that whether an entry is a
  /// credit or a debit stays a total function of its type. A single reversal
  /// type would have to be interpreted against whatever it reversed, and the
  /// first person to reverse a movement in the other direction would silently
  /// get the sign wrong.
  REVERSAL_CREDIT
  REVERSAL_DEBIT
}

/// Which way money is moving relative to the customer's account.
enum MovementDirection {
  DEPOSIT
  WITHDRAWAL
}

/// The rail the money travels on. Each rail differs only in what counts as
/// confirmation: a manager's approval for branch cash, a provider callback for
/// mobile money.
enum MovementChannel {
  BRANCH_CASH
  MOBILE_MONEY
}

enum MovementStatus {
  /// Raised, nothing dispatched yet. Branch cash sits here until a manager
  /// decides; mobile money passes through on its way to PROCESSING.
  PENDING

  /// Handed to a payment provider; we are waiting for their callback.
  PROCESSING

  COMPLETED
  REJECTED
  CANCELLED
  EXPIRED

  /// A payout was dispatched and we never learned the outcome — the provider
  /// timed out or answered ambiguously.
  ///
  /// This state exists precisely so that such a payout is never retried
  /// automatically. Retrying a transfer that may already have succeeded is how
  /// you pay someone twice. Money stays reserved and a human resolves it
  /// against the provider's records.
  UNRESOLVED
}

enum WebhookStatus {
  PENDING
  PROCESSED
  FAILED
  DEAD_LETTER
}

enum TransactionStatus {
  COMPLETED
  REVERSED
}

model User {
  id       String @id @default(uuid())
  fullName String
  email    String @unique
  phone    String?
  role     Role   @default(CUSTOMER)

  // Customers authenticate with account number + PIN; staff with email + password.
  // Both are bcrypt hashes — plaintext is never stored.
  pinHash      String?
  passwordHash String?

  isActive            Boolean   @default(true)
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  lastLoginAt         DateTime?

  /// Customers are onboarded by staff, never self-service. A record is not
  /// usable until a second staff member approves it.
  approvalStatus  ApprovalStatus @default(PENDING)
  rejectionReason String?
  approvedAt      DateTime?

  /// Who opened the record, and who signed it off. These must differ — that
  /// separation is the whole point of the workflow, and it is enforced in
  /// OnboardingService rather than being expressible as a database constraint.
  createdById String?
  createdBy   User?   @relation("CreatedCustomers", fields: [createdById], references: [id], onDelete: SetNull)

  approvedById String?
  approvedBy   User?   @relation("ApprovedCustomers", fields: [approvedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts     Account[]
  auditLogs    AuditLog[]    @relation("AuditActor")
  initiatedTxs Transaction[] @relation("TransactionInitiator")

  createdCustomers  User[] @relation("CreatedCustomers")
  approvedCustomers User[] @relation("ApprovedCustomers")

  requestedMovements MoneyRequest[] @relation("RequestedMovements")
  decidedMovements   MoneyRequest[] @relation("DecidedMovements")

  @@index([role])
  @@index([approvalStatus])
}

model Account {
  id            String        @id @default(uuid())
  accountNumber String        @unique
  type          AccountType   @default(CHECKING)
  /// Fails closed: a newly created account cannot move money until approval
  /// explicitly activates it.
  status        AccountStatus @default(PENDING)

  /// Balance in minor units. Only ever mutated inside a serializable
  /// transaction that also writes the matching Transaction ledger row.
  balance  BigInt @default(0)
  currency String @default("RWF")

  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions      Transaction[]  @relation("AccountLedger")
  counterpartyOfTxs Transaction[]  @relation("TransactionCounterparty")
  moneyRequests     MoneyRequest[]

  @@index([ownerId])
  @@index([status])
}

/// One row per ledger entry against a single account. A transfer produces two
/// rows (TRANSFER_OUT on the sender, TRANSFER_IN on the recipient) sharing a
/// `transferGroupId`, so the ledger stays balanced and auditable.
model Transaction {
  id        String            @id @default(uuid())
  reference String            @unique
  type      TransactionType
  status    TransactionStatus @default(COMPLETED)

  /// Always positive. `type` carries the direction.
  amount   BigInt
  currency String @default("RWF")

  /// Snapshot of the account balance immediately after this entry was applied.
  balanceAfter BigInt

  accountId String
  account   Account @relation("AccountLedger", fields: [accountId], references: [id], onDelete: Cascade)

  counterpartyAccountId String?
  counterpartyAccount   Account? @relation("TransactionCounterparty", fields: [counterpartyAccountId], references: [id], onDelete: SetNull)

  /// Shared by both legs of a transfer.
  transferGroupId String?

  description String?

  initiatedById String?
  initiatedBy   User?   @relation("TransactionInitiator", fields: [initiatedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  movementEntry    MoneyRequest? @relation("MovementEntry")
  movementReversal MoneyRequest? @relation("MovementReversal")

  @@index([accountId, createdAt])
  @@index([transferGroupId])
  @@index([createdAt])
  @@index([type])
}

/// An instruction to move money that needs confirming before it is final.
///
/// One state machine covers every rail:
///
///   requested -> PENDING -> COMPLETED
///                        -> REJECTED / CANCELLED / EXPIRED
///
/// What differs per rail is only *who or what confirms it*: a manager approving
/// a branch cash slip, or a provider callback for mobile money.
///
/// Deposits and withdrawals are deliberately not symmetric:
///
///   - a DEPOSIT writes no ledger entry until it is confirmed, because the
///     money is not ours until it has actually arrived;
///   - a WITHDRAWAL writes its debit immediately and holds it, because
///     otherwise the same balance could back several pending withdrawals at
///     once. If it does not complete, a compensating entry gives it back.
model MoneyRequest {
  id        String            @id @default(uuid())
  reference String            @unique
  direction MovementDirection
  channel   MovementChannel
  status    MovementStatus    @default(PENDING)

  amount   BigInt
  currency String @default("RWF")

  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  requestedById String
  requestedBy   User   @relation("RequestedMovements", fields: [requestedById], references: [id], onDelete: Cascade)

  /// Branch cash deposit only: the reference printed on the physical deposit
  /// slip. Unique across the platform, so the same slip cannot be claimed
  /// twice — by this customer or anyone else. This is the verification anchor
  /// that makes a customer-declared deposit checkable at all.
  slipReference String?   @unique
  branchName    String?
  depositedAt   DateTime?

  decidedById  String?
  decidedBy    User?     @relation("DecidedMovements", fields: [decidedById], references: [id], onDelete: SetNull)
  decidedAt    DateTime?
  decisionNote String?

  /// The ledger entry this produced: the credit for a completed deposit, or
  /// the held debit for a withdrawal. Unique, so a request can never be
  /// settled onto the ledger twice.
  transactionId String?      @unique
  transaction   Transaction? @relation("MovementEntry", fields: [transactionId], references: [id], onDelete: SetNull)

  /// The compensating entry written if a held withdrawal is given back.
  reversalTransactionId String?      @unique
  reversalTransaction   Transaction? @relation("MovementReversal", fields: [reversalTransactionId], references: [id], onDelete: SetNull)

  /// Withdrawals only: collect the cash by this time or it is given back.
  expiresAt DateTime?

  // --- Payment provider fields (mobile money) -------------------------

  /// Supplied by the client. Unique, so a double-tap or a retried request
  /// returns the original movement instead of starting a second one.
  idempotencyKey String? @unique

  /// The provider's own id for this transaction. How an incoming webhook is
  /// matched back to the request that started it.
  providerRef String? @unique

  /// The phone number money came from, or is going to. Payouts are restricted
  /// to the number on the customer's profile — sending to an arbitrary number
  /// supplied at request time is how a hijacked account gets cashed out.
  payerMsisdn String?

  providerStatus String?
  failureReason  String?

  /// Set when a payout was dispatched, so a stale PROCESSING request can be
  /// spotted and chased up.
  dispatchedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([accountId, createdAt])
  @@index([requestedById])
}

/// Every callback a payment provider has sent us.
///
/// Recorded before it is acted on, and keyed by the provider's own event id, so
/// a replayed or duplicated delivery is recognised and ignored rather than
/// applied twice. Providers retry aggressively and deliver out of order; this
/// table is what makes that harmless.
model WebhookEvent {
  id       String @id @default(uuid())
  provider String

  /// The provider's event id. Unique — this is the replay guard.
  providerEventId String @unique

  /// Their reference for the underlying transaction, used to find our request.
  providerRef String?

  payload        Json
  signatureValid Boolean

  status      WebhookStatus @default(PENDING)
  attempts    Int           @default(0)
  nextAttemptAt DateTime?
  lastError   String?
  processedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, nextAttemptAt])
  @@index([providerRef])
}

/// Append-only trail of sensitive actions, for staff oversight.
model AuditLog {
  id String @id @default(uuid())

  actorId String?
  actor   User?   @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  action     String
  entityType String?
  entityId   String?
  metadata   Json?
  ipAddress  String?
  success    Boolean @default(true)

  createdAt DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([action])
  @@index([createdAt])
}
